# Advertising Platform Integrations Configuration
# Copy this file to .env and fill in your credentials

# ===========================
# GOOGLE ADS CONFIGURATION
# ===========================
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # Optional: Manager account ID

# ===========================
# META ADS CONFIGURATION (Facebook/Instagram)
# ===========================
META_ADS_ACCESS_TOKEN=your_page_access_token_here
META_ADS_ACCOUNT_ID=act_123456789
META_ADS_APP_ID=your_app_id_here
META_ADS_APP_SECRET=your_app_secret_here
META_ADS_BUSINESS_ID=  # Optional: Business Manager ID

# ===========================
# LINKEDIN ADS CONFIGURATION
# ===========================
LINKEDIN_ADS_ACCESS_TOKEN=your_oauth_access_token_here
LINKEDIN_ADS_CLIENT_ID=your_oauth_client_id_here
LINKEDIN_ADS_CLIENT_SECRET=your_oauth_client_secret_here
LINKEDIN_ADS_REFRESH_TOKEN=  # Optional: For token refresh
LINKEDIN_ADS_ACCOUNT_ID=urn:li:sponsoredAccount:123456

# ===========================
# GENERAL SETTINGS
# ===========================
ADS_LOG_LEVEL=INFO
ADS_CACHE_ENABLED=true
ADS_CACHE_TTL=3600
