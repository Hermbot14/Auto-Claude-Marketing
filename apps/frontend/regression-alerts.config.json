{
  "$schema": "./regression-alerts.schema.json",
  "version": "1.0.0",
  "enabled": true,
  "channels": {
    "github": {
      "enabled": true,
      "onPullRequest": true,
      "onCommit": false,
      "commentFormat": "## Performance Regression Alert\n\n{summary}\n\n### Details\n{details}\n\n### Actions\n{actions}"
    },
    "slack": {
      "enabled": false,
      "webhookUrl": "${SLACK_WEBHOOK_URL}",
      "channel": "#performance",
      "username": "Performance Bot",
      "icon": ":chart_with_upwards_trend:"
    },
    "email": {
      "enabled": false,
      "recipients": ["dev-team@example.com"],
      "subject": "Performance Regression Alert - {project}"
    }
  },
  "thresholds": {
    "regression": {
      "percentage": 10,
      "absolute": {
        "timeToInteractive": 200,
        "firstContentfulPaint": 150,
        "bundleSize.main": 100000,
        "heapSize": 15000000
      }
    },
    "improvement": {
      "percentage": 5,
      "announce": true
    }
  },
  "rules": {
    "criticalRegressions": {
      "enabled": true,
      "conditions": {
        "anyMetricExceeds": "regression.percentage",
        "or": {
          "timeToInteractive": { "exceeds": 3000 },
          "bundleSize.main": { "exceeds": 2000000 }
        }
      },
      "actions": ["block_pr", "notify_urgently"]
    },
    "multipleWarnings": {
      "enabled": true,
      "conditions": {
        "metricCount": { "gte": 3 },
        "status": "warning"
      },
      "actions": ["add_label", "post_comment"]
    },
    "memoryLeak": {
      "enabled": true,
      "conditions": {
        "heapSize": { "trend": "increasing", "over": 3 },
        "slope": { "gte": 1000000 }
      },
      "actions": ["notify_urgently", "create_issue"]
    },
    "bundleSizeIncrease": {
      "enabled": true,
      "conditions": {
        "bundleSize": { "any": { "change": "gte", "percentage": 15 } }
      },
      "actions": ["require_review"]
    }
  },
  "exemptions": {
    "branches": ["develop", "feature/*"],
    "authors": ["dependabot[bot]", "renovate[bot]"],
    "filePatterns": [
      "*.test.ts",
      "*.test.tsx",
      "*.spec.ts",
      "src/renderer/components/__tests__/**"
    ],
    "commitMessages": [
      "*wip*",
      "*draft*",
      "*work in progress*"
    ]
  },
  "baselines": {
    "storage": "git",
    "branch": "main",
    "path": ".tmp/performance-baseline.json",
    "updateStrategy": {
      "onMergeToMain": true,
      "manualTrigger": true,
      "onImprovement": true
    }
  },
  "history": {
    "retention": {
      "days": 90,
      "snapshots": 1000
    },
    "aggregation": {
      "window": "7d",
      "percentile": 95
    }
  },
  "notifications": {
    "cooldown": {
      "duration": "1h",
      "sameIssue": true
    },
    "grouping": {
      "enabled": true,
      "window": "30m"
    },
    "templates": {
      "regression": {
        "title": "Performance Regression: {metrics}",
        "body": "## Performance Regression Detected\n\n**Pull Request:** {pr_url}\n**Author:** {author}\n\n### Affected Metrics\n{metrics_table}\n\n### Comparison\n| Metric | Before | After | Change |\n|--------|--------|-------|--------|\n{comparison_table}\n\n### Recommendations\n{recommendations}\n\n---\n*This alert was generated by the performance monitoring system.*"
      },
      "improvement": {
        "title": "Performance Improvement: {metrics}",
        "body": "## Performance Improvement Detected\n\nGreat work! This change improves performance metrics.\n\n### Improved Metrics\n{improved_metrics}\n\nPlease consider updating the baseline by running:\n```bash\nbun run performance-budget.js --save-baseline\n```"
      },
      "critical": {
        "title": "CRITICAL: Performance Regression",
        "body": "## Critical Performance Regression\n\nThis PR introduces significant performance degradation and **should not be merged** without review.\n\n### Critical Issues\n{critical_issues}\n\n### Immediate Actions Required\n1. Stop and review the changes\n2. Profile the performance bottleneck\n3. Optimize before proceeding\n4. Request performance review if needed\n\n---\n*This is a critical alert from the performance monitoring system.*"
      }
    }
  }
}
