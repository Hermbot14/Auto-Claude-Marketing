{
  "name": "auto-marketing",
  "version": "2.7.5",
  "description": "Autonomous multi-agent marketing AI framework powered by Claude",
  "license": "AGPL-3.0",
  "author": "Auto-Marketing Team",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:backend": "node scripts/install-backend.js",
    "install:frontend": "cd apps/frontend && bun install",
    "install:all": "bun run install:backend && bun run install:frontend",
    "start": "cd apps/frontend && bun run build && bun run start",
    "dev": "cd apps/frontend && bun run dev",
    "dev:debug": "cd apps/frontend && bun run dev:debug",
    "dev:mcp": "cd apps/frontend && bun run dev:mcp",
    "build": "cd apps/frontend && bun run build",
    "lint": "cd apps/frontend && bun run lint",
    "test": "cd apps/frontend && bun test",
    "test:backend": "node scripts/test-backend.js",
    "package": "cd apps/frontend && bun run package",
    "package:mac": "cd apps/frontend && bun run package:mac",
    "package:win": "cd apps/frontend && bun run package:win",
    "package:linux": "cd apps/frontend && bun run package:linux"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndyMik90/Auto-Claude.git"
  },
  "keywords": [
    "ai",
    "claude",
    "autonomous",
    "coding",
    "agents",
    "electron"
  ],
  "devDependencies": {
    "jsdom": "^27.4.0"
  },
  "dependencies": {
    "lucide-react": "^0.562.0"
  },
  "overrides": {
    "@electron/rebuild": "4.0.2"
  }
}
