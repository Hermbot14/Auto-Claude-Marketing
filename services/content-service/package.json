{
  "name": "content-service",
  "version": "0.1.0",
  "description": "Content Management Service for Auto Claude Marketing Hub",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "content",
    "cms",
    "marketing"
  ],
  "author": "Auto-Marketing Team",
  "license": "AGPL-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "mongoose": "^8.7.0",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "axios": "^1.7.7",
    "prom-client": "^15.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.54.0",
    "winston": "^3.16.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/mime-types": "^2.1.4",
    "typescript": "^5.6.2",
    "tsx": "^4.19.0",
    "vitest": "^2.1.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
